NODE_ENV=development
PORT=8080

# The ONLY two Supabase values required by Verity.
SUPABASE_URL=https://fnsnhasnjmvodkwmdqkc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_6QQc4wH4P8KKNj2ZYkUgLw_7fCX2rgw

PUBLIC_APP_URL=http://localhost:8080

# Private ClamAV daemon (TCP INSTREAM). Leave blank to keep certificate uploads quarantined as PENDING_SCAN.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# Optional server-only key used only by the authenticated Admin quarantine re-scan route.
# Never expose this value to the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Blockchain is a future optional layer. Keep disabled for normal Supabase-first operation.
VERITY_BLOCKCHAIN_MODE=disabled

# Future EVM integration settings. Do not configure/enable until asynchronous anchoring is implemented and tested.
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=