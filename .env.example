NODE_ENV=development
PORT=8080

# Supabase PostgreSQL — use the Session Pooler connection string (port 5432).
# Replace [YOUR-PASSWORD] with your Supabase database password.
# Keep the real value in .env only; never commit it to GitHub.
DATABASE_URL="postgresql://postgres.fnsnhasnjmvodkwmdqkc:[YOUR-PASSWORD]@[YOUR-SESSION-POOLER-HOST]:5432/postgres?schema=public"

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_NAME=Registry Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@verity.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassword123!
DEFAULT_INSTITUTION=Demo University
PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Optional EVM blockchain connection. Without these, the app uses its clearly labelled
# database-ledger demo mode; it does not claim to write to a public blockchain.
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
